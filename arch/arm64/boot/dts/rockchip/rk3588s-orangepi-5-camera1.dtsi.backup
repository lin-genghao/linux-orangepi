&csi2_dphy0 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			mipi_in_ucam0: endpoint@1 {
				remote-endpoint = <&ucam_out0>;
				data-lanes = <1 2>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			csidphy0_out: endpoint@0 {
				// remote-endpoint = <&mipi_csi2_input>;
				remote-endpoint = <&mipi2_csi2_input>;
				data-lanes = <1 2>;
			};
		};
	};
};

&i2c7 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;

	og02b1b: og02b1b@60 {
		compatible = "ovti,og02b1b";
		reg = <0x60>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
		clock-names = "xvclk";
		power-domains = <&power RK3588_PD_VI>;
		pinctrl-names = "default";
		pinctrl-0 = <&mipim0_camera3_clk>;
		// avdd-supply = <&vcc_avdd>;
		// dovdd-supply = <&vcc_dovdd>;
		// dvdd-supply = <&vcc_dvdd>;
		pwdn-gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "HK301";
		rockchip,camera-module-lens-name = "JZ-7070BS-A2-M8";

		port {
			ucam_out0: endpoint {
			remote-endpoint = <&mipi_in_ucam0>;
			data-lanes = <1 2>;
			};
		};
	};
	// vm149c_p1: vm149c-p1@c {

&rkisp0_vir1 {
	status = "okay";
	ports {
		port@0 {
			isp_in: endpoint@0 {
				// remote-endpoint = <&csi_dphy1_output>;
				// remote-endpoint = <&csidphy0_out>;
				remote-endpoint = <&mipi2_csi2_output>;
			};
		};
	};
};

&rkispp0 {
	status = "okay";
	/* the max input w h and fps of mulit sensor */
	max-input = <1600 1300 60>;
};
